# 투닥 아레나 비밀 설정 예시 — `cp .env.example .env`로 복사한 뒤 .env에 값을 채우세요.
# .env는 git에 올라가지 않아요(.gitignore). 노트북마다 따로 만들어야 해요.
# 메모해 둔 값을 = 뒤에 붙여넣고 저장하세요. 따옴표는 필요 없어요.

# Claude 두뇌 (봇 3명 공용)
ANTHROPIC_API_KEY=

# 디스코드 봇 토큰 4개 (Developer Portal → 봇 → 토큰)
DISCORD_TOKEN_COCO=
DISCORD_TOKEN_LOVEY=
DISCORD_TOKEN_ROU=
DISCORD_TOKEN_REFEREE=

# 디스코드 ID (개발자 모드 → 우클릭 → ID 복사)
# 내 사용자 ID
DISCORD_OWNER_ID=
# #투닥-중계 텍스트 채널 ID
DISCORD_TEXT_CHANNEL_ID=
# 심판 봇 ID와 봇들의 ID는 토큰에서 자동으로 알아내서 따로 안 넣어도 돼요.

# 웹 게임 포트
GAME_PORT=3300
