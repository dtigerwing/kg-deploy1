# 루소 목공소 로컬 설정. 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 git 에 올라가지 않음)
# 저장하면 서버를 다시 켜지 않아도 바로 적용됩니다.

# OpenAI — 정답 이미지 생성. 비워 두면 이미지 없이 정답 글씨만 보여줌
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=low

# TypeSafe Jev — 판단 표 만들기(npm run table), 흉내 낼 캐릭터 고르기
# 비워 두면 임시 판단 표와 간단한 규칙으로 동작
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 하루 이미지 생성 상한
DAILY_IMAGE_LIMIT=50

# 관리 페이지(/admin) 비밀번호. 배포에는 npx wrangler secret put ADMIN_PASSWORD 로 넣는다
ADMIN_PASSWORD=

# 창고 뒤지기: 목록 밖 후보를 떠올리는 OpenAI 글 모델 (키는 OPENAI_API_KEY 를 같이 씀)
TEXT_MODEL=gpt-5.6-terra
TEXT_REASONING=none
DAILY_SEARCH_LIMIT=300

PORT=3000
