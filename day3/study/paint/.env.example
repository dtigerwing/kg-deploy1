# OpenAI API 키를 = 뒤에 붙여넣고 저장하세요. (서버 재시작 필요 없음)
OPENAI_API_KEY=

# 아래는 선택 사항입니다. 비워두면 기본값을 씁니다.
# IMAGE_MODEL=gpt-image-2.5-sunburst
# TEXT_MODEL=gpt-5.6-terra
# IMAGE_QUALITY=medium   # 그림판 변환 품질: low | medium | high | xhigh | max | auto
# THUMB_QUALITY=high     # 공유 썸네일 품질 (한글 글자가 또렷하도록 기본 high)
# PORT=3001
