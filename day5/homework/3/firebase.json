{
  "hosting": {
    "site": "kdh-agentic-unity",
    "public": "public",
    "ignore": [
      "**/.*",
      "index.html",
      "app.js",
      "workflow.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/viewer.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
