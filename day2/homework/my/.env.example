# 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 git 에 올라가지 않음)
# 운영(Vercel)에서는 같은 이름으로 Vercel > Project > Settings > Environment Variables 에 넣습니다.

# OpenAI — 챗봇 답변 (imagegen 스크립트도 같은 키 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# 감정 분류 — TypeSafe AI 의 Jev (https://docs.typesafe.ai). 비워 두면 감정 분석 없이 동작
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 관리자 페이지(/admin) 로그인 비밀번호 (8자 이상) + 로그인 쿠키 서명용 임의 문자열
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Gmail SMTP 알림 — Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (16자리)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# 저장소 — Vercel > Storage > Upstash for Redis 를 프로젝트에 연결하면 자동으로 들어옴
# (로컬은 비워 두면 .data/dev-store.json 파일에 저장)
KV_REST_API_URL=
KV_REST_API_TOKEN=
